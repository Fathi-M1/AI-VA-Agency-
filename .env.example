# Every environment variable this app reads. Copy to .env.local and fill in values.
# Never commit real values: .env.local is git-ignored. Production values live in Vercel.

# Supabase project URL (Project Settings → Data API), server only.
SUPABASE_URL=
# Supabase secret / service-role key — server only, never in the browser. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase project URL again, for the sign-in session (same value as SUPABASE_URL). Safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key (Project Settings → API Keys). Safe in the browser: row-level security applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Groq API key for the AI agents (console.groq.com → API Keys).
GROQ_API_KEY=
# Cal.com API key (legacy optional calendar connection; switched off in production).
CALCOM_API_KEY=
# Google Gemini API key (kept for a possible future fallback; not read by the code today).
GEMINI_API_KEY=
# Tests only: base URL the HTTP security tests call, e.g. http://localhost:3100.
BASE_URL=
