      "id": "hmo",
      "ask": "Will you be using an HMO card for this visit?",
      "type": "choice",
      "options": [
        "No HMO",
        "$HMOS",
        "Other HMO"
      ],
      "applies_to": "all",
      "ask_if": null,
      "required": true,
      "summary_skip": [
        "No HMO"
      ]
    },
    {
      "id": "dentist",
      "ask": "Do you have a preferred dentist?",
      "type": "choice",
