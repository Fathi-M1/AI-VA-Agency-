  "faqs": [
    {
      "q": "Do you accept my HMO?",
      "a_template": "We accept {hmos|We don't accept HMO cards at the moment.}. Please bring your HMO card and one valid ID. If your HMO isn't listed, the clinic will confirm before your visit."
    },
    {
      "q": "Do you accept walk-ins?",
      "a_template": "{walk_in_answer}"
    },
    {
      "q": "What should I bring?",
      "a_template": "Please bring one valid ID{hmo_card_line}."
    },
    {
      "q": "How can I pay?",
      "a_template": "We accept {payment_methods}."
    },
    {
