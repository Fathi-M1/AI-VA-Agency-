    {
      "id": "service",
      "ask": "Which service would you like to book?",
      "type": "choice",
      "options": [
        "$SERVICES"
      ],
      "applies_to": "all",
      "ask_if": null,
      "required": true
    },
    {
      "id": "patient_type",
      "ask": "Is this your first visit with us, or have you been here before?",
      "type": "choice",
      "options": [
        "New patient",
        "Returning patient"
      ],
      "applies_to": "all",
      "ask_if": null,
      "required": true,
      "option_details": {
        "New patient": {
          "hint": "First time here"
        },
        "Returning patient": {
          "hint": "I've been here before"
        }
      }
    },
    {
      "id": "concern",
